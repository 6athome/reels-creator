{
  "name": "reels-creator-remotion",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "check": "tsc --noEmit",
    "render:smoke": "remotion render src/index.ts EnvironmentSmoke ../output/smoke/environment.mp4 --codec=h264 --concurrency=2"
  },
  "dependencies": {
    "remotion": "4.0.517",
    "@remotion/cli": "4.0.517",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6"
  }
}
